{
  "name": "crypto-compare",
  "version": "1.1.0",
  "description": "Interactive cryptographic algorithm reference — 17 categories, 97 algorithms, international",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/export-dataset.ts",
    "build": "next build",
    "export:dataset": "tsx scripts/export-dataset.ts",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:demos": "vitest run src/__tests__/demo-resources.test.ts src/__tests__/demo-sync-lib.test.ts src/__tests__/check-demo-sync-script.test.ts",
    "check:demos": "tsx scripts/check-demo-sync.ts",
    "check:demos:strict": "tsx scripts/check-demo-sync.ts --strict",
    "check:demos:json": "tsx scripts/check-demo-sync.ts --json",
    "check:demos:report": "tsx scripts/check-demo-sync.ts --json --report-path=demo-sync-report.json",
    "validate": "tsx scripts/validate-data.ts",
    "validate:full": "npm run validate && npm run check:demos:strict",
    "refresh": "tsx scripts/refresh-data.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
